{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and role information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "dg", "comptable", "chef_projet", "rh", "magasinier", "invite"] },
        "department": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "Industrial project or construction site managed by CORESI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 150 },
        "clientId": { "type": "string", "maxLength": 64 },
        "clientName": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "enum": ["ingenierie", "construction_industrielle", "genie_civil", "chaudronnerie", "tuyauterie", "instrumentation", "charpente", "maintenance"] },
        "location": { "type": "string", "maxLength": 150 },
        "budget": { "type": "number" },
        "spent": { "type": "number" },
        "progress": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "in_progress", "on_hold", "completed", "archived"] },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "managerId": { "type": "string", "maxLength": 64 },
        "managerName": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "clientName", "status", "budget"]
    },
    "DocumentRecord": {
      "title": "DocumentRecord",
      "description": "GED electronic document with Cloudinary metadata and OCR text",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "documentNumber": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "enum": ["factures", "devis", "bons_commande", "bons_livraison", "contrats", "administratif", "comptable", "financier", "projets", "rh", "rapports", "justificatifs", "plans_techniques", "autre"] },
        "cloudinaryPublicId": { "type": "string", "maxLength": 256 },
        "cloudinaryUrl": { "type": "string", "maxLength": 1024 },
        "secureUrl": { "type": "string", "maxLength": 1024 },
        "resourceType": { "type": "string", "maxLength": 32 },
        "format": { "type": "string", "maxLength": 16 },
        "originalFilename": { "type": "string", "maxLength": 256 },
        "fileSize": { "type": "number" },
        "mimeType": { "type": "string", "maxLength": 64 },
        "pageCount": { "type": "number" },
        "ocrText": { "type": "string", "maxLength": 50000 },
        "ocrConfidence": { "type": "number" },
        "projectId": { "type": "string", "maxLength": 64 },
        "clientId": { "type": "string", "maxLength": 64 },
        "supplierId": { "type": "string", "maxLength": 64 },
        "employeeId": { "type": "string", "maxLength": 64 },
        "invoiceId": { "type": "string", "maxLength": 64 },
        "expenseId": { "type": "string", "maxLength": 64 },
        "documentDate": { "type": "string", "maxLength": 32 },
        "amount": { "type": "number" },
        "tags": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["draft", "processing", "pending_validation", "validated", "archived", "deleted"] },
        "uploadedBy": { "type": "string", "maxLength": 100 },
        "uploadedById": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "status", "secureUrl"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Financial expense with attached receipt document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "reference": { "type": "string", "maxLength": 64 },
        "projectId": { "type": "string", "maxLength": 64 },
        "projectName": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "enum": ["materiel", "main_oeuvre", "transport", "sous_traitance", "consommable", "carburant", "frais_chantier", "autre"] },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 8 },
        "paymentMethod": { "type": "string", "enum": ["caisse", "virement_bancaire", "cheque", "carte", "mobile_money"] },
        "supplierId": { "type": "string", "maxLength": 64 },
        "supplierName": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 32 },
        "description": { "type": "string", "maxLength": 500 },
        "documentId": { "type": "string", "maxLength": 64 },
        "documentUrl": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "enum": ["en_attente", "valide", "paye", "rejete"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "reference", "amount", "category", "date", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Client or supplier invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["client", "fournisseur"] },
        "partyName": { "type": "string", "maxLength": 150 },
        "projectId": { "type": "string", "maxLength": 64 },
        "projectName": { "type": "string", "maxLength": 150 },
        "issueDate": { "type": "string", "maxLength": 32 },
        "dueDate": { "type": "string", "maxLength": 32 },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 8 },
        "status": { "type": "string", "enum": ["brouillon", "emis", "partiel", "paye", "en_retard", "annule"] },
        "documentId": { "type": "string", "maxLength": 64 },
        "documentUrl": { "type": "string", "maxLength": 1024 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "type", "partyName", "totalAmount", "status"]
    },
    "Employee": {
      "title": "Employee",
      "description": "CORESI staff member and HR profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "matricule": { "type": "string", "maxLength": 32 },
        "fullName": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "enum": ["direction", "ingenierie", "operations", "chaudronnerie", "tuyauterie", "comptabilite", "rh", "logistique", "securite"] },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 150 },
        "salary": { "type": "number" },
        "contractType": { "type": "string", "enum": ["cdi", "cdd", "prestation", "stage"] },
        "assignedProjectId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["actif", "conge", "mission", "archive"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "matricule", "fullName", "role", "department", "status"]
    },
    "Material": {
      "title": "Material",
      "description": "Industrial tooling, vehicles and stock items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "enum": ["outillage", "soudage", "levage", "protection", "vehicules", "consommables", "tuyauterie_acier"] },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 16 },
        "condition": { "type": "string", "enum": ["neuf", "bon_etat", "en_maintenance", "hors_service"] },
        "location": { "type": "string", "maxLength": 100 },
        "assignedProjectId": { "type": "string", "maxLength": 64 },
        "assignedProjectName": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["disponible", "assigne", "maintenance", "reforme"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "category", "quantity", "status"]
    },
    "Client": {
      "title": "Client",
      "description": "Corporate client of CORESI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 150 },
        "contactPerson": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 200 },
        "sector": { "type": "string", "maxLength": 100 },
        "activeProjectsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Industrial vendor and equipment supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 100 },
        "contactPerson": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security and trace audit log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 64 },
        "entity": { "type": "string", "maxLength": 64 },
        "entityId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userRole": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string" },
        "details": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "action", "entity", "timestamp"]
    },
    "SystemSettingsDoc": {
      "title": "SystemSettingsDoc",
      "description": "Global enterprise configuration and active modules settings",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string" },
        "list": { "type": "string" }
      }
    },
    "RolePermissionDoc": {
      "title": "RolePermissionDoc",
      "description": "Role-based matrix permissions for modules and actions",
      "type": "object",
      "properties": {
        "roleId": { "type": "string", "maxLength": 64 },
        "roleTitle": { "type": "string", "maxLength": 100 }
      },
      "required": ["roleId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile store"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Industrial projects"
    },
    "/documents/{documentId}": {
      "schema": "DocumentRecord",
      "description": "GED electronic documents with Cloudinary and OCR metadata"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Financial expenses"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Client and supplier invoices"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Company personnel records"
    },
    "/materials/{materialId}": {
      "schema": "Material",
      "description": "Equipment and stock inventory"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Corporate client directory"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Industrial supplier directory"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Security audit trail"
    },
    "/settings/{settingId}": {
      "schema": "SystemSettingsDoc",
      "description": "Modular configuration and system parameters"
    },
    "/roles/{roleId}": {
      "schema": "RolePermissionDoc",
      "description": "Role access control and permission matrix"
    }
  }
}
